using UnityEngine;

/// <summary>
/// Controls the player bird: flap input, death state, and collision handling.
/// </summary>
[RequireComponent(typeof(Rigidbody2D))]
public class BirdScript : MonoBehaviour
{
    [Header("References")]
    [SerializeField] private LogicManager logic;

    [Header("Settings")]
    [SerializeField] private float flapStrength = 10f;

    private Rigidbody2D rb;
    private bool birdIsAlive = true;

    private void Awake()
    {
        rb = GetComponent<Rigidbody2D>();
    }

    private void Start()
    {
        // Only do tag-lookup if not already assigned in Inspector
        if (logic == null)
            logic = GameObject.FindWithTag("Logic").GetComponent<LogicManager>();
    }

    private void Update()
    {
        if (birdIsAlive && Input.GetKeyDown(KeyCode.Space))
        {
            rb.linearVelocity = Vector2.up * flapStrength;
        }
    }

    private void OnCollisionEnter2D(Collision2D collision)
    {
        if (!birdIsAlive) return;  // guard against multi-collision triggers
        birdIsAlive = false;
        logic.GameOver();
    }
}