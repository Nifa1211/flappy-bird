using UnityEngine;
using UnityEngine.UI;
using UnityEngine.SceneManagement;

/// <summary>
/// Manages game state: score tracking, game-over screen, and scene restart.
/// </summary>
public class LogicManager : MonoBehaviour
{
    [Header("UI References")]
    [SerializeField] private Text scoreText;
    [SerializeField] private GameObject gameOverScreen;

    private int playerScore;

    /// <summary>Adds to the player score and refreshes the UI text.</summary>
    public void AddScore(int amount)
    {
        playerScore += amount;
        scoreText.text = playerScore.ToString();
    }

    /// <summary>Displays the game-over screen.</summary>
    public void GameOver()
    {
        gameOverScreen.SetActive(true);
    }

    /// <summary>Reloads the active scene to restart the game.</summary>
    public void RestartGame()
    {
        SceneManager.LoadScene(SceneManager.GetActiveScene().buildIndex);
    }

#if UNITY_EDITOR
    // Keeps the editor helper — removed from builds automatically
    [ContextMenu("Increase Score (Debug)")]
    private void DebugAddScore() => AddScore(1);
#endif
}