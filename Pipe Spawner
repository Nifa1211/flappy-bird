using UnityEngine;

/// <summary>
/// Spawns pipe prefabs at a fixed interval with randomised vertical offset.
/// </summary>
public class PipeSpawnerScript : MonoBehaviour
{
    [Header("References")]
    [SerializeField] private GameObject pipePrefab;

    [Header("Spawn Settings")]
    [SerializeField] private float spawnRate    = 2f;
    [SerializeField] private float heightOffset = 10f;

    private float timer;

    private void Start()
    {
        // Spawn one immediately so the player isn't waiting on the first interval
        SpawnPipe();
        timer = 0f;
    }

    private void Update()
    {
        timer += Time.deltaTime;

        if (timer >= spawnRate)
        {
            SpawnPipe();
            timer = 0f;
        }
    }

    private void SpawnPipe()
    {
        float spawnY = Random.Range(
            transform.position.y - heightOffset,
            transform.position.y + heightOffset
        );

        Instantiate(
            pipePrefab,
            new Vector3(transform.position.x, spawnY, 0f),
            Quaternion.identity   // cleaner than inheriting spawner rotation
        );
    }
}