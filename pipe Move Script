using UnityEngine;

/// <summary>
/// Moves a pipe leftward at a constant speed and destroys it once off-screen.
/// </summary>
public class PipeMoveScript : MonoBehaviour
{
    [Header("Settings")]
    [SerializeField] private float moveSpeed = 5f;
    [SerializeField] private float deadZoneX = -45f;  // world-space X, not -100 which was way off-screen

    private void Update()
    {
        transform.Translate(Vector3.left * moveSpeed * Time.deltaTime);

        if (transform.position.x < deadZoneX)
            Destroy(gameObject);
    }
}